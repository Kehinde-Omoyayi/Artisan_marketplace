{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["python313", "gcc", "gdal", "geos", "proj", "postgresql"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "exec gunicorn config.wsgi --bind 0.0.0.0:$PORT --workers 3 --timeout 60 --access-logfile - --error-logfile -",
    "preDeployCommand": ["python manage.py migrate --noinput"],
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/healthz/"
  }
}
