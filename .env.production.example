# =====================================================================================
# Nigeria Artisan Marketplace — V2 PRODUCTION environment
#
# This file answers ONE question for each variable: where does the real value come
# from? For the deploy mechanics themselves (Railway services, first-run commands,
# webhook registration, troubleshooting table) see docs/DEPLOYMENT.md — that runbook
# already exists in this project and is the authoritative source; don't duplicate it
# here.
#
# This is NOT a file to upload to your host. Paste each line into your host's
# environment variable UI (Railway: Project -> your service -> Variables tab ->
# "Raw Editor" accepts a whole block like this pasted at once). Never commit this
# file once the placeholders below are replaced with real values.
#
# Every line marked TODO needs a real value before you go live. Run this to see
# exactly what's still missing at any point:
#   python manage.py check_production_ready
# =====================================================================================

# --- Django core ---------------------------------------------------------------------
# Freshly generated for you, unique from the one in your local .env — do not reuse
# the same SECRET_KEY across environments.
SECRET_KEY=iy*^_mxokf4_*ip4@7w!$wod%0v%!u^2z3!&7leb6(a6s)p1u%
DEBUG=False

# Auto-detected from the system libgdal/libgeos on Linux hosts — leave both blank.
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=

# The interactive test console can create real bookings and move real payouts.
# It must be False (or unset) in production.
ENABLE_DEV_CONSOLE=False

# Already correct for a default Railway deployment (*.railway.app). If you add a
# custom domain later, add it to both lines below, comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app
CSRF_TRUSTED_ORIGINS=https://*.railway.app
TIME_ZONE=Africa/Lagos

# --- Database (Supabase Postgres, PostGIS enabled) ------------------------------------
# 1. supabase.com -> New project (note the database password you set here).
# 2. In the project: SQL Editor -> New query -> run:  CREATE EXTENSION IF NOT EXISTS postgis;
# 3. Project -> Connect (top of dashboard) -> copy the "Session pooler" connection
#    string, NOT "Transaction pooler" (Django keeps long-lived connections and uses
#    features the transaction pooler doesn't support well) -> paste below, then
#    swap the postgresql:// prefix for postgis:// so Django's GIS backend picks it up.
# TODO — replace with your real Supabase connection string:
DATABASE_URL=postgis://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# --- Web chat (the required channel — see docs/WEBCHAT.md) ----------------------------
# 1. termii.com -> sign up -> Dashboard -> API Key. Nigerian SMS/OTP aggregator; this
#    is what actually gets your phone-verification codes onto a real phone. Verify
#    the current API shape against developers.termii.com before relying on it — a
#    third party's API, not something this repo controls.
# 2. TERMII_SENDER_ID needs approval from Termii for most routes — start that early,
#    it's not instant.
# WITHOUT TERMII_API_KEY SET: the site loads fine, but nobody can get past phone
# verification in the chat widget — this is the single easiest thing to forget here.
# TODO:
TERMII_API_KEY=
TERMII_SENDER_ID=ArtisanNG
TERMII_BASE_URL=https://api.ng.termii.com/api
SITE_NAME=Nigeria Artisan Marketplace

# --- WhatsApp Cloud API (OPTIONAL — web chat above is the required channel) -----------
# Only fill this in if you also want the WhatsApp channel running alongside web chat.
# Nothing in the request path depends on it being configured.
# 1. developers.facebook.com -> My Apps -> Create App -> "Other" -> "Business" ->
#    add the WhatsApp product.
# 2. App dashboard -> WhatsApp -> API Setup panel gives you a temporary token and
#    your WHATSAPP_PHONE_NUMBER_ID immediately — good enough to test with.
# 3. For a token that doesn't expire in 24h: Business Settings -> System users ->
#    Add -> create a system user -> assign your WhatsApp Business Account (WABA) to
#    it with full control -> generate a token scoped to whatsapp_business_messaging
#    + whatsapp_business_management -> that's your permanent WHATSAPP_TOKEN.
# 4. App dashboard -> App Settings -> Basic -> "App Secret" (click Show) -> that's
#    WHATSAPP_APP_SECRET. NOT the same value as WHATSAPP_TOKEN.
# 5. WHATSAPP_VERIFY_TOKEN is not issued by Meta — you make this string up yourself,
#    then enter the SAME string in App dashboard -> WhatsApp -> Configuration ->
#    Webhook -> Verify Token, alongside your callback URL
#    (https://<your-app>.railway.app/whatsapp/webhook/).
# Leave all four blank to run without WhatsApp entirely:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v19.0

# --- Paystack -----------------------------------------------------------------------
# 1. dashboard.paystack.com/#/signup -> create account -> complete Compliance
#    (business profile + documents) to unlock Live mode; Test mode works immediately.
# 2. Dashboard -> Settings -> API Keys & Webhooks -> "API Configuration - Test Mode"
#    (or "Live Mode" once activated) -> copy the Secret Key and Public Key.
# 3. Same page -> set your Webhook URL to
#    https://<your-app>.railway.app/payments/webhook/ (set it for both Test and
#    Live mode separately — they're independent).
# TODO — both keys, and set PAYSTACK_ENVIRONMENT to "live" once you switch:
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_ENVIRONMENT=test

# --- Redis --------------------------------------------------------------------------
# On Railway: in your project, Cmd/Ctrl+K -> "Redis" -> Add. Railway auto-creates a
# URL variable on that Redis service — reference it from this service's Variables
# tab as ${{Redis.REDIS_URL}} instead of retyping a value here. Per docs/DEPLOYMENT.md:
# double-check the exact variable name Railway gave it (it's sometimes REDISURL or
# REDIS_PRIVATE_URL, not REDIS_URL) — either rename it to REDIS_URL or update
# config/settings.py to match.
# (Deploying somewhere other than Railway? Upstash's free tier gives you a
# redis:// connection string with no server to manage.)
# TODO — do not deploy with the localhost value below, it will not resolve:
REDIS_URL=redis://localhost:6379/0

SENTRY_DSN=

# --- Private object storage (artisan ID-verification photos) ------------------------
# Any S3-compatible provider works. Two straightforward options:
#   a) Supabase Storage: your project -> Storage -> New bucket -> name it
#      artisan-verification-private, toggle it Private -> Project Settings ->
#      Data API -> "S3 Connection" gives you the endpoint URL + a place to
#      generate an access key pair (Storage -> S3 Access Keys).
#   b) Backblaze B2: create an account -> Buckets -> Create a Bucket -> Private ->
#      then App Keys -> Add a New Application Key, scoped to that bucket.
# TODO — all four:
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=artisan-verification-private
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

# --- Email fallback (used when a WhatsApp send fails) --------------------------------
# Simplest path: a Gmail address with an "App Password" (Google Account -> Security
# -> 2-Step Verification -> App passwords — needs 2FA turned on first).
#   EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_HOST_USER=you@gmail.com,
#   EMAIL_HOST_PASSWORD=<the 16-character app password>
# More deliverable at scale: a transactional provider such as Resend, Postmark, or
# Mailgun's SMTP credentials — sign up, verify a sending domain, use the SMTP
# details they give you instead.
# TODO — all four:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@artisanmarketplace.ng
