
SECRET_KEY=generate-a-long-random-string-see-README
DEBUG=True

GDAL_LIBRARY_PATH=C:\Users\omoya\AppData\Local\Programs\OSGeo4W\bin\gdal313.dll

# Interactive test console at "/". NOT part of the V2 manual — dev/staging only.
# Leave this unset (or False) in production: it can create bookings and move payouts.
ENABLE_DEV_CONSOLE=True
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app
CSRF_TRUSTED_ORIGINS=https://*.railway.app
TIME_ZONE=Africa/Lagos

# --- Database (V1 Supabase connection string, PostGIS enabled per Part 4 Step 6) ------
# Supabase -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgis://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# --- V1 WhatsApp Cloud API (now OPTIONAL — see "Web chat" below) ----------------------
# The web chat box is the primary, required channel as of V2.1; nothing in the
# request path depends on these being set. Fill them in only if you also want the
# WhatsApp channel running alongside webchat.
WHATSAPP_TOKEN=your-permanent-system-user-token-see-part-18.5
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-own-made-up-handshake-string
WHATSAPP_API_VERSION=v19.0

# --- V1 Paystack -----------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# --- V2 additions (Part 3 Step 6 + Part 4 Step 4) ---------------------------------------
REDIS_URL=redis://localhost:6379/0
PAYSTACK_ENVIRONMENT=test
SENTRY_DSN=
# Meta App dashboard -> App Settings -> Basic -> App Secret. NOT the same as WHATSAPP_TOKEN.
WHATSAPP_APP_SECRET=paste-your-meta-app-secret-here

# --- V2 private object storage (Part 18.2) ----------------------------------------------
# Supabase Storage or Backblaze B2 — must be a PRIVATE bucket.
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=artisan-verification-private
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

# --- V2 email fallback (Part 12 Step 3) --------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@artisanmarketplace.ng

# --- V2.1 Web chat (replaces WhatsApp as the required channel — see webchat/) -----------
SITE_NAME=Nigeria Artisan Marketplace
# How long an OTP is valid, and the minimum gap between resend requests.
WEBCHAT_OTP_TTL_SECONDS=300
WEBCHAT_OTP_RESEND_COOLDOWN_SECONDS=45
# How long a browser session keeps "owning" delivery for its phone number after it
# was last active, before notifications.services falls back to WhatsApp/email again.
WEBCHAT_ACTIVE_WINDOW_HOURS=24
# Suggested poll interval for the widget's JS, in milliseconds — tune per environment
# without a frontend deploy.
WEBCHAT_POLL_INTERVAL_MS=2500
# Optional real SMS/OTP delivery (Nigeria-first: Termii — https://termii.com). Leave
# TERMII_API_KEY blank to run with the console/log fallback: safe for dev and CI,
# and structurally inert in production (DEBUG is False there, so no code is ever
# echoed back over the API either way) — but you MUST set this before a real launch,
# or nobody can actually receive their verification code.
TERMII_API_KEY=
TERMII_SENDER_ID=ArtisanNG
TERMII_BASE_URL=https://api.ng.termii.com/api

